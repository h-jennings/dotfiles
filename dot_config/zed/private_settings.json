// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "relative_line_numbers": "enabled",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "toolbar": {
    "quick_actions": false,
  },
  "inline_code_actions": false,
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "preview_tabs": {
    "enabled": false,
  },
  "max_tabs": 1,
  "sticky_scroll": {
    "enabled": true,
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "default"
      },
      "type": "registry",
    },
  },
  "agent": {
    "dock": "left",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "ui_font_family": ".ZedSans",
  "buffer_font_family": "Berkeley Mono",
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "Nushu Light",
    "dark": "Nushu Dark",
  },
  "go_to_definition_fallback": "none",
  "project_panel": {
    "dock": "right",
  },
}
