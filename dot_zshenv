
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# XDG base directory
export XDG_CONFIG_HOME="$HOME/.config"

# Editor
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

# PATH additions
export PATH="/Users/hunterjennings/.local/bin:$PATH"

# pnpm
export PNPM_HOME="/Users/hunterjennings/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
