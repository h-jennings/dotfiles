# oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git zsh-autosuggestions zsh-fzf-history-search tmux)
source $ZSH/oh-my-zsh.sh

# yazi cd on quit
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# aliases
alias lg="lazygit"
alias v="nvim"

# tools
eval "$(mise activate zsh)"
# mise shims as a PATH fallback: `mise activate` injects version-pinned install
# dirs, which go stale for long-lived processes (the Herdr server spawns `bun`
# for the annotate plugin). Appended, so activate still wins in this shell.
export PATH="$PATH:$HOME/.local/share/mise/shims"
. "$HOME/.atuin/bin/env"
eval "$(atuin init zsh)"

# opencode
export PATH="$HOME/.opencode/bin:$PATH"
