#!/bin/bash
# uirec-encode — compress a CleanShot recording and file it on the Desktop.
#   uirec-encode --watch [--timeout N]   wait for the next new CleanShot mp4
#   uirec-encode FILE...                 re-encode specific files
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/uirec"
MEDIA_DIR="$HOME/Library/Application Support/CleanShot/media"
PENDING="$STATE_DIR/pending.json"

OUT_DIR="$HOME/Desktop/Recordings"; FPS=30; CRF=23; SCALE=1; AUDIO=keep
LABEL=""; VW=1512; WATCH=0; TIMEOUT=7200; FILES=()

if [ -f "$PENDING" ] && command -v jq >/dev/null; then
  eval "$(jq -r '"OUT_DIR=\(.out_dir|@sh) FPS=\(.fps) CRF=\(.crf) SCALE=\(.scale) AUDIO=\(.audio|@sh) LABEL=\(.label|@sh) VW=\(.width)"' "$PENDING")"
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --watch)   WATCH=1; shift ;;
    --timeout) TIMEOUT=$2; shift 2 ;;
    -*) echo "uirec-encode: unknown flag $1" >&2; exit 1 ;;
    *)  FILES+=("$1"); shift ;;
  esac
done

log() { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }
notify() {
  osascript -e "display notification \"$2\" with title \"$1\" sound name \"Pop\"" >/dev/null 2>&1 || true
}

settled() {   # true once nothing holds the file open and its size stops moving
  local f=$1 a b
  command -v lsof >/dev/null && lsof -t -- "$f" >/dev/null 2>&1 && return 1
  a=$(stat -f%z -- "$f" 2>/dev/null || echo 0); sleep 2
  b=$(stat -f%z -- "$f" 2>/dev/null || echo 0)
  [ "$a" = "$b" ] && [ "$b" -gt 0 ]
}

encode() {
  local src=$1 dst stamp base aargs vf
  # CleanShot captures at 2x on a retina display, so SCALE=1 means halve it.
  # Deriving from the source beats a hardcoded width: correct for any input.
  if [ "$SCALE" = 1 ]; then
    vf="scale=trunc(iw/4)*2:-2:flags=lanczos"
  else
    vf="scale=trunc(iw/2)*2:-2:flags=lanczos"
  fi
  stamp=$(date '+%Y-%m-%d-%H%M%S')
  base="${LABEL:+${LABEL}-}${stamp}"
  base=$(printf '%s' "$base" | tr ' /' '--')
  mkdir -p "$OUT_DIR"
  dst="$OUT_DIR/${base}.mp4"

  if [ "$AUDIO" = strip ]; then
    aargs=(-an)
  else
    aargs=(-map '0:a?' -c:a aac -b:a 128k -ac 1)
  fi

  log "encoding $(basename "$src") -> $dst"
  ffmpeg -nostdin -hide_banner -loglevel error -y -i "$src" \
    -map 0:v:0 "${aargs[@]}" \
    -vf "$vf" -r "$FPS" \
    -c:v libx264 -crf "$CRF" -preset veryfast -pix_fmt yuv420p \
    -movflags +faststart "$dst"

  local insz outsz
  insz=$(du -h "$src" | cut -f1); outsz=$(du -h "$dst" | cut -f1)
  log "done: $insz -> $outsz"
  notify "Recording ready" "$(basename "$dst") ($insz to $outsz)"
  printf '%s\n' "$dst"
}

if [ "${#FILES[@]}" -gt 0 ]; then
  for f in "${FILES[@]}"; do [ -f "$f" ] || { log "missing: $f"; continue; }; encode "$f"; done
  exit 0
fi

[ "$WATCH" = 1 ] || { echo "uirec-encode: pass --watch or a file" >&2; exit 1; }
[ -d "$MEDIA_DIR" ] || { log "no CleanShot media dir at $MEDIA_DIR"; exit 1; }

before="$STATE_DIR/.seen.$$"
mkdir -p "$STATE_DIR"
find "$MEDIA_DIR" -type f -name '*.mp4' 2>/dev/null | sort > "$before"
log "watching for a new recording (timeout ${TIMEOUT}s)"

deadline=$(( $(date +%s) + TIMEOUT ))
new=""
while [ "$(date +%s)" -lt "$deadline" ]; do
  sleep 2
  new=$(find "$MEDIA_DIR" -type f -name '*.mp4' 2>/dev/null | sort | comm -13 "$before" - | head -1)
  [ -n "$new" ] && break
done
rm -f "$before"

[ -n "$new" ] || { log "timed out, nothing recorded"; exit 0; }
log "found $(basename "$new"), waiting for CleanShot to finish writing"

for _ in $(seq 1 150); do settled "$new" && break; sleep 2; done
settled "$new" || { log "file never settled: $new"; exit 1; }

encode "$new"
rm -f "$STATE_DIR/watcher.pid"
